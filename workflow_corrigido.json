    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pega o body\nconst body = $json.body;\n\n// Tenta acessar a mensagem\nconst msg = body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\n\n// 1. Se não for mensagem, corta o fluxo\nif (!msg) {\n  console.log(\"Ignorando evento que não é mensagem.\");\n  return [];\n}\n\n// 2. Se o tipo NÃO for message (ex: status, delivery, read), corta\nif (msg.type !== \"text\" && msg.type !== \"button\" && msg.type !== \"interactive\") {\n  console.log(\"Ignorando evento que não é mensagem do usuário.\");\n  return [];\n}\n\n// 3. Agora sim: é uma mensagem válida do usuário\nreturn {\n  from: msg.from,\n  text: msg.text?.body || \"\",\n  type: msg.type,\n  id: msg.id\n};\n"
      },
